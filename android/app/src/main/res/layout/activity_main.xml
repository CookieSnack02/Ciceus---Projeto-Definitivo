<?xml version="1.0" encoding="utf-8"?>
<!-- a WebView ocupa a tela toda. por cima dela ficam a barrinha de
     carregamento e a tela de "sem conexao", que so aparecem quando precisam -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ciceus_superficie">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/carregando"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="@color/ciceus_destaque"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sem_conexao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ciceus_fundo"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/logo_ciceus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="serif"
            android:text="@string/sem_conexao_titulo"
            android:textColor="@color/ciceus_texto"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="@string/sem_conexao_texto"
            android:textColor="@color/ciceus_texto_suave"
            android:textSize="15sp" />

        <Button
            android:id="@+id/tentar_novamente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fundo_botao"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/tentar_novamente"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
